// The daemon: a supervisor that owns every torrent and answers HTTP.
//
// SINGLE-ACTOR BY CONSTRUCTION. The event loop accepts one connection at a time
// and handles it inline -- there is no goroutine per request -- so the job table
// has exactly one writer and no lock. That is not caution for its own sake: the
// download engine already runs a goroutine per peer, and the moment an HTTP
// handler on another goroutine touched the same state, `machin build
// --race-safe` would refuse to build. A control-plane request takes microseconds
// against a download that takes minutes, so serialising them costs nothing.
//
// The loop stays responsive because `accept()` honours socket_timeout: it
// returns -1 after the tick, the loop pumps every job and seeder, and comes
// back round. Blocking work -- resolving a magnet through the DHT, which takes
// tens of seconds -- runs on its own goroutine and reports back over a channel,
// so `add` answers immediately with state "resolving".

// ratio_pct is a seed ratio in PERCENT: 50 means stop at 0.5x, 200 at 2x, 0
// means never stop. It is an integer because MFL has no floats, and percent
// rather than hundredths because "stop at 50% of what I downloaded" is what
// the number actually means to a person.
type Rec struct { id string  source string  dir string  seed int  up_limit int  down_limit int  ratio_pct int  infohash string  name string  state string  done int  total int  bytes int  peers int  uploaded int  err string }

type Resolved struct { id string  ok int  path string  infohash string  name string  peers string  err string }

func essaim_home() (h) { h = env("ESSAIM_HOME")
	if h == "" { h = env("HOME") + "/.essaim" } }

func state_path() (p) { p = essaim_home() + "/state.json" }

func torrent_cache(ih) (p) { p = essaim_home() + "/torrents/" + ih + ".torrent" }

// ---- home ownership ----
//
// state.json is the daemon's whole memory of WHICH torrents it manages, and it
// is rewritten wholesale on shutdown. Two daemons sharing one ESSAIM_HOME
// destroy each other silently: the second loads the registry, the first exits
// and writes ITS view back, and whichever exits last wins. A daemon that
// started with an empty registry wipes a running one's torrents. Nothing warns
// you -- the files stay on disk, so it looks like they were merely forgotten.
//
// There is no atomic create-if-absent to lock with: MFL's mkdir returns 0 for
// a directory that already exists, on purpose, so the usual mkdir-as-mutex
// trick silently succeeds twice. Ownership is therefore a claim rather than a
// lock, and it is enforced where the damage happens -- at the WRITE.
//
// A daemon writes a random token into daemon.owner at startup and re-reads it
// before every save. Two daemons racing means the later claim wins the file,
// and the earlier one then declines to persist instead of overwriting work it
// does not own. Startup also refuses outright when the recorded owner is still
// answering, which turns the common case into a clear error rather than a
// race nobody sees.

var OWNER_TOKEN = ""

func owner_path() (p) { p = essaim_home() + "/daemon.owner" }

// owner_read returns the recorded token and control port, or "" and 0.
func owner_read() (tok, port) { tok = ""  port = 0
	raw := trim(read_file(owner_path()))
	if raw == "" { return tok, port }
	sp := index(raw, " ")
	if sp <= 0 { return tok, port }
	tok = substr(raw, 0, sp)
	port = parse_int(substr(raw, sp + 1, len(raw))) }

// owner_answers asks whether a daemon is still live on that port. There is no
// getpid in MFL, so the control port is the only handle on liveness.
func owner_answers(port) (yes) { yes = 0
	if port <= 0 { return yes }
	status, _, err := http_get_b("http://127.0.0.1:" + str(port) + "/_health", 1500)
	if err == "" { if status == 200 { yes = 1 } } }

func owner_claim(port) (tok) { mkdir_p(essaim_home())
	tok = new_id() + new_id()
	write_file(owner_path(), tok + " " + str(port))
	OWNER_TOKEN = tok }

// owner_still_mine is the guard on every write. An unreadable owner file means
// somebody removed it; taking that as "mine" keeps a single daemon working
// after a tidy-up, which is the common case, while a token that belongs to
// SOMEONE ELSE is the one thing that must stop a write.
func owner_still_mine() (yes) { yes = 1
	if OWNER_TOKEN == "" { return yes }
	tok, _ := owner_read()
	if tok == "" { return yes }
	if tok != OWNER_TOKEN { yes = 0 } }

func owner_release() { if OWNER_TOKEN != "" { tok, _ := owner_read()
		if tok == OWNER_TOKEN { remove(owner_path()) } } }

// ---- registry ----
//
// The daemon needs to know WHICH torrents it manages; per-torrent progress is
// still re-derived from the files on disk at start, so this file is a small
// list of intents, not a progress journal that could disagree with reality.

func registry_load() (recs) { recs = []Rec{}
	raw := read_file(state_path())
	if raw == "" { return recs }
	i := 0
	for i < 4096 { idv, e := json_get(raw, ".jobs[" + str(i) + "].id")
		if e != "" { return recs }
		r := Rec{id: unq(idv), source: unq(jget(raw, ".jobs[" + str(i) + "].source")), dir: unq(jget(raw, ".jobs[" + str(i) + "].dir")), seed: parse_int(jget(raw, ".jobs[" + str(i) + "].seed")), up_limit: parse_int(jget(raw, ".jobs[" + str(i) + "].up_limit")), down_limit: parse_int(jget(raw, ".jobs[" + str(i) + "].down_limit")), ratio_pct: parse_int(jget(raw, ".jobs[" + str(i) + "].ratio_pct")), infohash: unq(jget(raw, ".jobs[" + str(i) + "].infohash")), name: unq(jget(raw, ".jobs[" + str(i) + "].name")), state: "pending"}
		recs = append(recs, r)
		i = i + 1 } }

func jget(j, path) (v) { v = ""
	x, e := json_get(j, path)
	if e == "" { v = x } }

func unq(v) (out) { out = v
	if len(v) >= 2 { if charat(v, 0) == "\"" { out = substr(v, 1, len(v) - 1) } } }

func registry_save(recs) { // Refusing to write is always safer than overwriting a registry that now
	// belongs to another daemon: the torrents are still on disk either way.
	if owner_still_mine() == 0 { eprint("essaim: another daemon owns " + essaim_home() + " -- not saving the registry")
		return }
	mkdir_p(essaim_home())
	rows := []string{}
	i := 0
	for i < len(recs) { r := recs[i]
		rows = append(rows, "{\"id\":\"" + r.id + "\",\"source\":\"" + jesc(r.source) + "\",\"dir\":\"" + jesc(r.dir) + "\",\"seed\":" + str(r.seed) + ",\"up_limit\":" + str(r.up_limit) + ",\"down_limit\":" + str(r.down_limit) + ",\"ratio_pct\":" + str(r.ratio_pct) + ",\"infohash\":\"" + r.infohash + "\",\"name\":\"" + jesc(r.name) + "\"}")
		i = i + 1 }
	write_file(state_path(), "{\"version\":1,\"jobs\":[" + join(rows, ",") + "]}") }

// ---- resolution, off the event loop ----
//
// Turning a source into a .torrent can take a minute through the DHT, so it runs
// on its own goroutine. The result is CACHED to disk, which means a daemon
// restart re-reads the file instead of asking the swarm again.
func resolver(id, src, port, timeout, out) { pid := peer_id_new()
	raw := bytes("")
	peers := []Peer{}
	if has_prefix(src, "magnet:") { m := magnet_parse(src)
		if m.ok == 0 { out <- json(Resolved{id: id, ok: 0, err: m.err})  return }
		cached := read_file_bytes(torrent_cache(m.infohash))
		if len(cached) > 0 { raw = cached }
		peers = gather_peers(m.announce, m.infohash, 1048576, pid, port, timeout, 0)
		if len(peers) < 4 { dp, _ := dht_get_peers(m.infohash, 30, 8, 3000, 0)
			k := 0
			for k < len(dp) { if peer_new(peers, dp[k]) == 1 { peers = append(peers, dp[k]) }  k = k + 1 } }
		if len(raw) == 0 { if len(peers) == 0 { out <- json(Resolved{id: id, ok: 0, err: "no peers found for " + m.infohash})  return }
			r, e := meta_from_swarm(peers, m.infohash, pid, 8000, 0)
			if e != "" { out <- json(Resolved{id: id, ok: 0, err: "metadata: " + e})  return }
			raw = r } }
	if has_prefix(src, "magnet:") == false { b, e := source_bytes(src)
		if e != "" { out <- json(Resolved{id: id, ok: 0, err: "cannot read source: " + e})  return }
		raw = b }
	t := torrent_parse(raw)
	if t.ok == 0 { out <- json(Resolved{id: id, ok: 0, err: t.err})  return }
	mkdir_p(essaim_home() + "/torrents")
	write_file_bytes(torrent_cache(t.infohash), raw)
	if len(peers) == 0 { peers = gather_peers(t.announce, t.infohash, t.total, pid, port, timeout, 0)
		if len(peers) < 4 { dp, _ := dht_get_peers(t.infohash, 30, 8, 3000, 0)
			k := 0
			for k < len(dp) { if peer_new(peers, dp[k]) == 1 { peers = append(peers, dp[k]) }  k = k + 1 } } }
	out <- json(Resolved{id: id, ok: 1, path: torrent_cache(t.infohash), infohash: t.infohash, name: t.name, peers: peers_join(peers)}) }

func peers_join(ps) (s) { parts := []string{}
	i := 0
	for i < len(ps) { parts = append(parts, ps[i].ip + ":" + str(ps[i].port))  i = i + 1 }
	s = join(parts, ",") }

// ---- the HTTP surface ----

func req_read(fd) (method, path, body, ok) { method = ""  path = ""  body = ""  ok = 0
	socket_timeout(fd, 5000)
	raw := bytes("")
	guard := 0
	for bytes_index(raw, bytes("\r\n\r\n"), 0) < 0 { guard = guard + 1
		if guard > 64 { return method, path, body, ok }
		c := read_bytes(fd)
		if len(c) == 0 { return method, path, body, ok }
		raw = bytes_concat(raw, c)
		if len(raw) > 262144 { return method, path, body, ok } }
	hdrend := bytes_index(raw, bytes("\r\n\r\n"), 0)
	head := bytes_str(bytes_sub(raw, 0, hdrend))
	lines := split(head, "\r\n")
	if len(lines) == 0 { return method, path, body, ok }
	parts := split(lines[0], " ")
	if len(parts) < 2 { return method, path, body, ok }
	method = parts[0]
	path = parts[1]
	clen := parse_int(header_of(raw, "content-length"))
	have := len(raw) - (hdrend + 4)
	for have < clen { c := read_bytes(fd)
		if len(c) == 0 { break }
		raw = bytes_concat(raw, c)
		have = len(raw) - (hdrend + 4) }
	body = bytes_str(bytes_sub(raw, hdrend + 4, len(raw)))
	ok = 1 }

func req_token(fd) (t) { t = "" }

func respond(fd, status, body) { txt := "200 OK"
	if status == 400 { txt = "400 Bad Request" }
	if status == 401 { txt = "401 Unauthorized" }
	if status == 404 { txt = "404 Not Found" }
	if status == 500 { txt = "500 Internal Server Error" }
	write(fd, "HTTP/1.1 " + txt + "\r\nContent-Type: application/json\r\nContent-Length: " + str(len(body)) + "\r\nConnection: close\r\n\r\n" + body)
	close(fd) }

func rec_json(r) (j) { j = "{\"id\":\"" + r.id + "\",\"source\":\"" + jesc(r.source) + "\",\"dir\":\"" + jesc(r.dir) + "\",\"infohash\":\"" + r.infohash + "\",\"name\":\"" + jesc(r.name) + "\",\"state\":\"" + r.state + "\",\"pieces_done\":" + str(r.done) + ",\"pieces_total\":" + str(r.total) + ",\"bytes\":" + str(r.bytes) + ",\"peers\":" + str(r.peers) + ",\"uploaded_bytes\":" + str(r.uploaded) + ",\"seed\":" + boolstr(r.seed) + ",\"up_limit_kbs\":" + str(r.up_limit) + ",\"down_limit_kbs\":" + str(r.down_limit) + ",\"ratio_limit_pct\":" + str(r.ratio_pct) + ",\"error\":\"" + jesc(r.err) + "\"}" }

func recs_json(recs) (j) { rows := []string{}
	i := 0
	for i < len(recs) { rows = append(rows, rec_json(recs[i]))  i = i + 1 }
	j = "[" + join(rows, ",") + "]" }

func new_id() (s) { s = to_hex(rand_bytes(6)) }

// parse_flag accepts both encodings of a boolean. The daemon has always READ
// seed as an integer and WRITTEN it as a bool, so a client that reads a record,
// changes a field and posts it back used to send something the parser did not
// understand. Now either works.
func parse_flag(v) (n) { n = 0
	if v == "true" { n = 1  return n }
	if v == "false" { n = 0  return n }
	n = parse_int(v) }

// ratio_done reports whether a torrent has already uploaded its configured
// share. It is checked in two places -- before starting a seeder and after
// every pump -- because a ratio that only stops a RUNNING seeder would restart
// itself on the next loop.
func ratio_done(r) (d) { d = 0
	if r.ratio_pct <= 0 { return d }
	if r.bytes <= 0 { return d }
	if r.uploaded * 100 >= r.bytes * r.ratio_pct { d = 1 } }

// ---- the supervisor ----
//
// One loop owns everything: the record table, the running jobs, the seeders.
// It accepts a connection (or times out), handles it inline, then pumps every
// job and seeder before coming back round.

func daemon_serve(host, port, token, tick, peerport, timeout, progress) (err) { err = ""
	mkdir_p(essaim_home())
	srv := listen(port)
	if srv < 0 { err = "cannot bind " + host + ":" + str(port)  return err }
	socket_timeout(srv, tick)
	// Before the registry is read, so a second daemon never gets far enough to
	// overwrite it on the way out.
	otok, oport := owner_read()
	if otok != "" { if owner_answers(oport) == 1 { close(srv)
			err = "another essaim daemon owns " + essaim_home() + " and is answering on port " + str(oport)
			return err } }
	owner_claim(port)
	recs := registry_load()
	jobs := []Job{}
	seeders := []Seeder{}
	resolved := make(chan string)
	pid := peer_id_new()
	// Restoring a torrent must not go near the network if it does not have to.
	// A cached .torrent plus the files on disk answer "is this finished?" on
	// their own, so a completed torrent comes back instantly and only an
	// unfinished one pays for peer discovery.
	i := 0
	for i < len(recs) { jobs = append(jobs, Job{id: recs[i].id, active: 0})
		seeders = append(seeders, Seeder{active: 0, srv: 0 - 1})
		restored := 0
		if recs[i].infohash != "" { cached := read_file_bytes(torrent_cache(recs[i].infohash))
			if len(cached) > 0 { t := torrent_parse(cached)
				if t.ok == 1 { jobs[i] = job_start(recs[i].id, t, recs[i].dir, []Peer{}, pid, timeout, recs[i].down_limit)
					recs[i].total = t.npieces
					recs[i].done = jobs[i].s.done
					recs[i].bytes = jobs[i].s.bytes
					if jobs[i].s.complete == 1 { recs[i].state = "complete"
						restored = 1
						if progress == 1 { eprint("essaim: " + recs[i].name + " restored complete (" + str(recs[i].done) + "/" + str(recs[i].total) + " verified)") } } } } }
		if restored == 0 { recs[i].state = "resolving"
			go resolver(recs[i].id, recs[i].source, peerport, timeout, resolved) }
		i = i + 1 }
	if progress == 1 { eprint("essaim: daemon listening on " + host + ":" + str(port) + " (" + str(len(recs)) + " torrents restored)") }
	running := 1
	for running == 1 { fd := accept(srv)
		if fd >= 0 { method, path, body, ok := req_read(fd)
			if ok == 0 { close(fd) }
			if ok == 1 { if path == "/_health" { respond(fd, 200, "{\"ok\":true,\"version\":\"" + VERSION + "\",\"jobs\":" + str(len(recs)) + ",\"pid\":" + str(0) + "}") }
				if path == "/_shutdown" { if token_ok(body, token) == 0 { respond(fd, 401, "{\"ok\":false,\"error\":\"bad or missing token\"}") }
					if token_ok(body, token) == 1 { respond(fd, 200, "{\"ok\":true,\"stopping\":true}")  running = 0 } }
				if path == "/torrents" { if method == "GET" { respond(fd, 200, "{\"ok\":true,\"torrents\":" + recs_json(recs) + "}") }
					if method == "POST" { src := unq(jget(body, ".source"))
						if src == "" { respond(fd, 400, "{\"ok\":false,\"error\":\"source is required\"}") }
						if src != "" { r := Rec{id: new_id(), source: src, dir: unq(jget(body, ".dir")), seed: parse_flag(jget(body, ".seed")), up_limit: parse_int(jget(body, ".up_limit")), down_limit: parse_int(jget(body, ".down_limit")), ratio_pct: parse_int(jget(body, ".ratio_limit_pct")), state: "resolving"}
							if r.dir == "" { r.dir = "." }
							recs = append(recs, r)
							jobs = append(jobs, Job{id: r.id, active: 0})
							seeders = append(seeders, Seeder{active: 0, srv: 0 - 1})
							registry_save(recs)
							go resolver(r.id, r.source, peerport, timeout, resolved)
							respond(fd, 200, "{\"ok\":true,\"torrent\":" + rec_json(r) + "}") } } }
				if has_prefix(path, "/torrents/") { id := substr(path, 10, len(path))
					k := rec_index(recs, id)
					if k < 0 { respond(fd, 404, "{\"ok\":false,\"error\":\"no such torrent\"}") }
					if k >= 0 { if method == "GET" { respond(fd, 200, "{\"ok\":true,\"torrent\":" + rec_json(recs[k]) + "}") }
						// PATCH adjusts a torrent in place. Before this the
						// control plane could create and destroy but not
						// change, so altering one integer meant rm + add --
						// which threw away the record and re-resolved the
						// metadata. Only fields that are present are touched.
						if method == "PATCH" { pseed := jget(body, ".seed")
							pup := jget(body, ".up_limit")
							pdown := jget(body, ".down_limit")
							pratio := jget(body, ".ratio_limit_pct")
							if pseed != "" { recs[k].seed = parse_flag(pseed) }
							if pup != "" { recs[k].up_limit = parse_int(pup) }
							if pratio != "" { recs[k].ratio_pct = parse_int(pratio) }
							// A download pacer takes its interval when the job
							// starts, so a new cap applies the next time the
							// torrent starts.
							//
							// Restarting the job here to apply it sooner was
							// tried and rejected -- but NOT for the reason you
							// might expect. MFL channel sends do not block:
							// they queue, verified with 100k sends to a channel
							// nobody was reading. So job_stop cannot stall this
							// loop, and there is no deadlock to avoid.
							//
							// The real cost is the restart itself. Stopping a
							// healthy download throws away its peers, and the
							// resolver has to find them again -- on an
							// intermittent swarm that took minutes and left the
							// torrent sitting in "resolving". Trading a working
							// download for a faster-applied speed limit is a
							// bad deal, so the cap waits.
							if pdown != "" { recs[k].down_limit = parse_int(pdown) }
							// A running seeder holds its cap from when it
							// started, so any change to seeding means stopping
							// it. srv goes back to -1 so the pump is free to
							// start a fresh one with the new settings; without
							// that reset the restart condition never fires
							// again and seeding stays off for good.
							if pseed != "" { if seeders[k].active == 1 { seeders[k] = seed_stop(seeders[k])
									seeders[k].srv = 0 - 1
									if recs[k].state == "seeding" { recs[k].state = "complete" } } }
							if pup != "" { if seeders[k].active == 1 { seeders[k] = seed_stop(seeders[k])
									seeders[k].srv = 0 - 1
									if recs[k].state == "seeding" { recs[k].state = "complete" } } }
							registry_save(recs)
							respond(fd, 200, "{\"ok\":true,\"torrent\":" + rec_json(recs[k]) + "}") }
						if method == "DELETE" { jobs[k] = job_stop(jobs[k])
							seeders[k] = seed_stop(seeders[k])
							recs = rec_remove(recs, k)
							jobs = job_remove(jobs, k)
							seeders = seeder_remove(seeders, k)
							registry_save(recs)
							respond(fd, 200, "{\"ok\":true,\"removed\":\"" + id + "\"}") } } } } }
		// fold in anything the resolvers finished
		drained := 1
		for drained == 1 { drained = 0
			select { case m := <-resolved: drained = 1
				rv := parse(m, Resolved{})
				k := rec_index(recs, rv.id)
				if k >= 0 { if rv.ok == 0 { recs[k].state = "error"  recs[k].err = rv.err }
					if rv.ok == 1 { recs[k].infohash = rv.infohash
						recs[k].name = rv.name
						recs[k].err = ""
						t := torrent_parse(read_file_bytes(rv.path))
						if t.ok == 0 { recs[k].state = "error"  recs[k].err = "cached torrent will not parse" }
						if t.ok == 1 { recs[k].total = t.npieces
							jobs[k] = job_start(rv.id, t, recs[k].dir, parse_peers(rv.peers), pid, timeout, recs[k].down_limit)
							// copy the starting counts immediately: a torrent
							// already complete on disk never enters the pump
							// loop, and would otherwise report 0 pieces forever
							recs[k].done = jobs[k].s.done
							recs[k].bytes = jobs[k].s.bytes
							recs[k].state = "downloading"
							if jobs[k].active == 0 { recs[k].state = "stalled"
								if jobs[k].s.complete == 1 { recs[k].state = "complete" } }
							registry_save(recs) } } }
			default: } }
		// pump every job and seeder
		i = 0
		for i < len(jobs) { if jobs[i].active == 1 { jobs[i] = job_pump(jobs[i], 0)
				recs[i].done = jobs[i].s.done
				recs[i].bytes = jobs[i].s.bytes
				recs[i].peers = jobs[i].s.peers_ok
				if jobs[i].active == 0 { recs[i].state = "stalled"
					if jobs[i].s.done >= jobs[i].t.npieces { recs[i].state = "complete"
						if progress == 1 { eprint("essaim: " + recs[i].name + " complete") } } } }
			if seeders[i].active == 1 { seeders[i] = seed_pump(seeders[i], 0)
				recs[i].uploaded = seeders[i].up
				recs[i].peers = seeders[i].peers
				if ratio_done(recs[i]) == 1 { seeders[i] = seed_stop(seeders[i])
					recs[i].state = "complete"
					registry_save(recs)
					if progress == 1 { eprint("essaim: " + recs[i].name + " reached its seed ratio, stopped seeding") } } }
			// a completed torrent that asked to seed starts serving, once
			// The seed flag stays the user's intent; ratio_done is what
			// stops it being acted on, so "I asked to seed" and "it has
			// finished seeding" remain two different facts.
			// A FAILED seed_start used to be retried on every tick, because
			// its result (active==0, srv==-1) is this very condition. Each
			// retry re-read and re-verified the torrent on the main loop,
			// whose arena is never reclaimed, so a daemon that could not bind
			// its peer port grew ~1.8 MB/s until it was killed. The usual way
			// in was a cap change: seed_stop could not free the port, so the
			// rebind failed and never stopped failing. Back off instead, and
			// keep the delay in the Seeder so a fresh struct from seed_start
			// does not reset it.
			if recs[i].state == "complete" { if recs[i].seed == 1 { if ratio_done(recs[i]) == 0 { if seeders[i].active == 0 { if seeders[i].srv == 0 - 1 { if now_ms() >= seeders[i].retry_at { // The job already holds the parsed torrent, so re-reading and
								// re-parsing the cache file here cost ~930 kB of main-loop arena
								// per attempt -- which a retrying seeder paid over and over.
								t := jobs[i].t
								if t.ok == 0 { t = torrent_parse(read_file_bytes(torrent_cache(recs[i].infohash))) }
								if t.ok == 1 { wait := seeders[i].retry_ms
									sd, serr := seed_start(t, recs[i].dir, peerport, recs[i].up_limit, pid)
									seeders[i] = sd
									if serr == "" { recs[i].state = "seeding"
										recs[i].err = ""
										if progress == 1 { eprint("essaim: seeding " + recs[i].name) } }
									if serr != "" { recs[i].err = serr
										// 1s on the first failure, doubling to a 60s ceiling
										next := 1000
										if wait > 0 { next = wait * 2 }
										if next > 60000 { next = 60000 }
										seeders[i].retry_ms = next
										seeders[i].retry_at = now_ms() + next
										if progress == 1 { eprint("essaim: " + serr + " -- retrying in " + str(next / 1000) + "s") } } } } } } } } }
			i = i + 1 } }
	close(srv)
	registry_save(recs)
	owner_release()
	if progress == 1 { eprint("essaim: daemon stopped") } }

// token_ok gates shutdown. An empty configured token means the daemon is
// loopback-only and unauthenticated, which is the default; set --token to
// require one.
func token_ok(body, token) (ok) { ok = 0
	if token == "" { ok = 1  return ok }
	if unq(jget(body, ".token")) == token { ok = 1 } }

func rec_index(recs, id) (k) { k = 0 - 1
	i := 0
	for i < len(recs) { if recs[i].id == id { k = i  return k }  i = i + 1 } }

func rec_remove(recs, k) (out) { out = []Rec{}
	i := 0
	for i < len(recs) { if i != k { out = append(out, recs[i]) }  i = i + 1 } }

func job_remove(jobs, k) (out) { out = []Job{}
	i := 0
	for i < len(jobs) { if i != k { out = append(out, jobs[i]) }  i = i + 1 } }

func seeder_remove(sds, k) (out) { out = []Seeder{}
	i := 0
	for i < len(sds) { if i != k { out = append(out, sds[i]) }  i = i + 1 } }
