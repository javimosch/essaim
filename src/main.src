// The command surface. Every command prints one JSON object on stdout and
// exits with a semantic code; progress and diagnostics go to stderr only.

func arg_at(a, i) (v) { v = ""
	if i < len(a) { v = a[i] } }

// flag_val reads "--name value"; flag_on reports a bare "--name". Args are
// parsed by hand rather than through a builder so that a missing value is a
// typed error instead of a silent default.
func flag_val(a, name, dflt) (v) { v = dflt
	i := 0
	for i < len(a) { if a[i] == name { if i + 1 < len(a) { v = a[i + 1] }  return v }
		i = i + 1 } }

func flag_on(a, name) (on) { on = 0
	i := 0
	for i < len(a) { if a[i] == name { on = 1  return on }  i = i + 1 } }

func main() { a := args()
	cmd := arg_at(a, 1)
	if cmd == "" { cmd = "help-json" }
	if cmd == "version" { emit("{\"version\":\"" + VERSION + "\"}") }
	if cmd == "guide" { cmd_guide(a) }
	if cmd == "help-json" { cmd_help_json() }
	if cmd == "info" { cmd_info(a) }
	if cmd == "get" { cmd_get(a) }
	if cmd == "search" { cmd_search(a) }
	if cmd == "sources" { cmd_sources() }
	if cmd == "peers" { cmd_peers(a) }
	if cmd == "install" { cmd_install(a) }
	if cmd == "uninstall" { cmd_uninstall(a) }
	if cmd == "update" { cmd_update(a) }
	if cmd == "feedback" { cmd_feedback(a) }
	fail(EXIT_ARGS, "unknown_command", "no such command: " + cmd, []string{"essaim help-json", "essaim guide"}) }

// cmd_peers answers "is this swarm alive?" without downloading a byte. It is
// also the honest way to see the DHT working on its own: pass --no-trackers and
// every address returned came from the DHT.
func cmd_peers(a) { src := arg_at(a, 2)
	if src == "" { fail(EXIT_ARGS, "missing_argument", "peers needs a magnet, infohash, or .torrent", []string{"essaim peers <40-hex-infohash>"}) }
	timeout := parse_int(flag_val(a, "--timeout", "15000"))
	port := parse_int(flag_val(a, "--port", "6881"))
	quiet := flag_on(a, "--quiet")
	progress := 1
	if quiet == 1 { progress = 0 }
	ih := ""
	ann := []string{}
	if len(src) == 40 { ih = to_lower(src) }
	if has_prefix(src, "magnet:") { m := magnet_parse(src)
		if m.ok == 0 { fail(EXIT_VALUE, "bad_magnet", m.err, []string{}) }
		ih = m.infohash
		ann = m.announce }
	if ih == "" { raw, err := source_bytes(src)
		if err != "" { fail(EXIT_NOTFOUND, "not_found", "cannot read " + src, []string{}) }
		t := torrent_parse(raw)
		if t.ok == 0 { fail(EXIT_VALUE, "bad_torrent", t.err, []string{}) }
		ih = t.infohash
		ann = t.announce }
	pid := peer_id_new()
	from_tr := []Peer{}
	if flag_on(a, "--no-trackers") == 0 { from_tr = gather_peers(ann, ih, 1048576, pid, port, timeout, progress) }
	from_dht := []Peer{}
	dhterr := ""
	if flag_on(a, "--no-dht") == 0 { from_dht, dhterr = dht_get_peers(ih, 50, 10, 3000, progress) }
	all := []Peer{}
	i := 0
	for i < len(from_tr) { if peer_new(all, from_tr[i]) == 1 { all = append(all, from_tr[i]) }  i = i + 1 }
	i = 0
	for i < len(from_dht) { if peer_new(all, from_dht[i]) == 1 { all = append(all, from_dht[i]) }  i = i + 1 }
	rows := []string{}
	i = 0
	for i < len(all) { rows = append(rows, "{\"ip\":\"" + all[i].ip + "\",\"port\":" + str(all[i].port) + "}")  i = i + 1 }
	emit("{\"infohash\":\"" + ih + "\",\"peers\":" + str(len(all)) + ",\"from_trackers\":" + str(len(from_tr)) + ",\"from_dht\":" + str(len(from_dht)) + ",\"dht_error\":\"" + jesc(dhterr) + "\",\"addresses\":[" + join(rows, ",") + "]}") }

func cmd_sources() { srcs := sources_default()
	rows := []string{}
	i := 0
	for i < len(srcs) { rows = append(rows, "{\"name\":\"" + srcs[i].name + "\",\"kind\":\"" + srcs[i].kind + "\",\"category\":\"" + srcs[i].cat + "\",\"enabled\":" + boolstr(srcs[i].enabled) + "}")
		i = i + 1 }
	emit("{\"sources\":[" + join(rows, ",") + "]}") }

func cmd_search(a) { q := arg_at(a, 2)
	if q == "" { fail(EXIT_ARGS, "missing_argument", "search needs a query", []string{"essaim search \"ubuntu\"", "essaim search \"one piece\" --cat anime"}) }
	if has_prefix(q, "--") { fail(EXIT_ARGS, "missing_argument", "search needs a query before its flags", []string{"essaim search \"ubuntu\" --cat movies"}) }
	cat := flag_val(a, "--cat", "all")
	limit := parse_int(flag_val(a, "--limit", "25"))
	timeout := parse_int(flag_val(a, "--timeout", "15000"))
	quiet := flag_on(a, "--quiet")
	progress := 1
	if quiet == 1 { progress = 0 }
	hits := search_all(sources_selected(flag_val(a, "--source", env("ESSAIM_SOURCES"))), q, cat, limit, timeout, progress)
	rows := []string{}
	i := 0
	for i < len(hits) { h := hits[i]
		rows = append(rows, "{\"source\":\"" + h.source + "\",\"name\":\"" + jesc(h.name) + "\",\"infohash\":\"" + h.infohash + "\",\"size_bytes\":" + str(h.size) + ",\"seeders\":" + str(h.seeders) + ",\"magnet\":\"" + jesc(h.magnet) + "\",\"torrent\":\"" + jesc(h.torrent) + "\"}")
		i = i + 1 }
	emit("{\"query\":\"" + jesc(q) + "\",\"category\":\"" + cat + "\",\"count\":" + str(len(hits)) + ",\"results\":[" + join(rows, ",") + "]}") }

// source_bytes resolves a torrent argument to the raw bytes of a .torrent.
// A magnet is accepted by the parser but cannot be downloaded yet: its metadata
// lives in the swarm (BEP 9), so it is refused with a precise reason rather
// than a generic failure.
func source_bytes(src) (raw, err) { raw = bytes("")  err = ""
	if has_prefix(src, "magnet:") { err = "magnet"  return raw, err }
	if has_prefix(src, "http://") { raw, err = fetch_torrent(src)  return raw, err }
	if has_prefix(src, "https://") { raw, err = fetch_torrent(src)  return raw, err }
	raw = read_file_bytes(src)
	if len(raw) == 0 { err = "notfound" } }

func fetch_torrent(url) (raw, err) { raw = bytes("")  err = ""
	status, body, e := http_get_b(url, 20000)
	if e != "" { err = "network:" + e  return raw, err }
	if status != 200 { err = "http:" + str(status)  return raw, err }
	raw = body }

func cmd_info(a) { src := arg_at(a, 2)
	if src == "" { fail(EXIT_ARGS, "missing_argument", "info needs a .torrent path, url, or magnet", []string{"essaim info ./file.torrent"}) }
	if has_prefix(src, "magnet:") { m := magnet_parse(src)
		if m.ok == 0 { fail(EXIT_VALUE, "bad_magnet", m.err, []string{"check the xt=urn:btih: parameter"}) }
		// --fetch resolves the metadata from the swarm so the file list can be
		// inspected BEFORE committing to a download. No content is transferred:
		// BEP 9 carries only the info dict.
		if flag_on(a, "--fetch") == 1 { raw, _ := resolve_magnet(src, peer_id_new(), 6881, 15000, 1 - flag_on(a, "--quiet"), flag_on(a, "--no-dht"))
			t := torrent_parse(raw)
			if t.ok == 0 { fail(EXIT_EXTERNAL, "bad_metadata", "the swarm returned metadata that does not parse: " + t.err, []string{"retry -- another peer may serve it"}) }
			emit(torrent_json(t)) }
		emit("{\"kind\":\"magnet\",\"infohash\":\"" + m.infohash + "\",\"name\":\"" + jesc(m.name) + "\",\"trackers\":" + str_list(m.announce) + ",\"has_metadata\":false,\"hint\":\"add --fetch to pull the file list from the swarm\"}") }
	raw, err := source_bytes(src)
	if err == "notfound" { fail(EXIT_NOTFOUND, "not_found", "cannot read " + src, []string{"check the path"}) }
	if err != "" { fail(EXIT_NETWORK, "fetch_failed", "could not fetch " + src + ": " + err, []string{"retry", "download the .torrent manually"}) }
	t := torrent_parse(raw)
	if t.ok == 0 { fail(EXIT_VALUE, "bad_torrent", t.err, []string{"the file may be html, not a .torrent"}) }
	emit(torrent_json(t)) }

func torrent_json(t) (j) { fj := []string{}
	i := 0
	for i < len(t.files) { fj = append(fj, "{\"path\":\"" + jesc(t.files[i].path) + "\",\"length\":" + str(t.files[i].length) + ",\"offset\":" + str(t.files[i].offset) + "}")
		i = i + 1 }
	j = "{\"kind\":\"torrent\",\"infohash\":\"" + t.infohash + "\",\"name\":\"" + jesc(t.name) + "\",\"total_bytes\":" + str(t.total) + ",\"piece_length\":" + str(t.piecelen) + ",\"pieces\":" + str(t.npieces) + ",\"trackers\":" + str_list(t.announce) + ",\"files\":[" + join(fj, ",") + "]}" }

func str_list(xs) (j) { parts := []string{}
	i := 0
	for i < len(xs) { parts = append(parts, "\"" + jesc(xs[i]) + "\"")  i = i + 1 }
	j = "[" + join(parts, ",") + "]" }

func cmd_get(a) { src := arg_at(a, 2)
	if src == "" { fail(EXIT_ARGS, "missing_argument", "get needs a .torrent path, url, or magnet", []string{"essaim get ./file.torrent --dir ./downloads"}) }
	dir := flag_val(a, "--dir", ".")
	timeout := parse_int(flag_val(a, "--timeout", "15000"))
	deadline := parse_int(flag_val(a, "--deadline", "600000"))
	port := parse_int(flag_val(a, "--port", "6881"))
	quiet := flag_on(a, "--quiet")
	progress := 1
	if quiet == 1 { progress = 0 }
	pid := peer_id_new()
	raw := bytes("")
	err := ""
	peers := []Peer{}
	if has_prefix(src, "magnet:") { raw, peers = resolve_magnet(src, pid, port, timeout, progress, flag_on(a, "--no-dht")) }
	if has_prefix(src, "magnet:") == false { raw, err = source_bytes(src) }
	if err == "notfound" { fail(EXIT_NOTFOUND, "not_found", "cannot read " + src, []string{"check the path"}) }
	if err != "" { fail(EXIT_NETWORK, "fetch_failed", "could not fetch " + src + ": " + err, []string{"retry"}) }
	t := torrent_parse(raw)
	if t.ok == 0 { fail(EXIT_VALUE, "bad_torrent", t.err, []string{"the file may be html, not a .torrent"}) }
	if mkdir_p(dir) == 0 { fail(EXIT_VALUE, "bad_dir", "cannot create " + dir, []string{"pick a writable --dir"}) }
	if progress == 1 { eprint("essaim: " + t.name + " -- " + str(t.total) + " bytes in " + str(t.npieces) + " pieces") }
	if len(peers) == 0 { peers = gather_peers(t.announce, t.infohash, t.total, pid, port, timeout, progress) }
	if flag_on(a, "--no-dht") == 0 { if len(peers) < 4 { dp, derr := dht_get_peers(t.infohash, 30, 8, 3000, progress)
			if derr != "" { if progress == 1 { eprint("essaim: dht -> " + derr) } }
			k := 0
			for k < len(dp) { if peer_new(peers, dp[k]) == 1 { peers = append(peers, dp[k]) }  k = k + 1 } } }
	if len(peers) == 0 { fail(EXIT_NETWORK, "no_peers", "neither the trackers nor the DHT returned a peer for " + t.infohash, []string{"retry -- swarms are intermittent", "check network reachability to udp trackers"}) }
	if progress == 1 { eprint("essaim: " + str(len(peers)) + " peers, starting") }
	s := engine_download(t, dir, peers, pid, timeout, deadline, progress)
	body := "{\"infohash\":\"" + t.infohash + "\",\"name\":\"" + jesc(t.name) + "\",\"dir\":\"" + jesc(dir) + "\",\"complete\":" + boolstr(s.complete) + ",\"pieces_done\":" + str(s.done) + ",\"pieces_total\":" + str(s.total) + ",\"bytes\":" + str(s.bytes) + ",\"peers_used\":" + str(s.peers_ok) + ",\"peers_dead\":" + str(s.peers_dead) + ",\"elapsed_ms\":" + str(s.elapsed) + "}"
	if s.complete == 0 { println("{\"ok\":false,\"version\":\"" + VERSION + "\",\"error\":{\"code\":105,\"type\":\"incomplete\",\"message\":\"stopped with " + str(s.done) + "/" + str(s.total) + " pieces\",\"recoverable\":true,\"suggestions\":[\"run the same command again -- verified pieces are kept and the download resumes\"]},\"data\":" + body + "}")
		flush()
		exit(EXIT_EXTERNAL) }
	emit(body) }

// resolve_magnet turns a magnet into a real .torrent document by asking the
// swarm for its metadata (BEP 9). The peers found along the way are reused for
// the download itself, so the tracker is not announced to twice.
func resolve_magnet(src, pid, port, timeout, progress, nodht) (raw, peers) { raw = bytes("")  peers = []Peer{}
	m := magnet_parse(src)
	if m.ok == 0 { fail(EXIT_VALUE, "bad_magnet", m.err, []string{"check the xt=urn:btih: parameter"}) }
	if progress == 1 { eprint("essaim: magnet " + m.infohash + " -- asking the swarm for metadata") }
	peers = gather_peers(m.announce, m.infohash, 1048576, pid, port, timeout, progress)
	// The DHT is what makes a trackerless magnet work at all, so it is tried
	// whenever the trackers (if any) came up short, not only when there are none.
	if nodht == 0 { if len(peers) < 4 { dp, derr := dht_get_peers(m.infohash, 30, 8, 3000, progress)
			if derr != "" { if progress == 1 { eprint("essaim: dht -> " + derr) } }
			k := 0
			for k < len(dp) { if peer_new(peers, dp[k]) == 1 { peers = append(peers, dp[k]) }  k = k + 1 } } }
	if len(peers) == 0 { fail(EXIT_NETWORK, "no_peers", "neither the trackers nor the DHT returned a peer for " + m.infohash, []string{"retry -- swarms and the DHT are both intermittent", "check that outbound UDP is not blocked"}) }
	r, err := meta_from_swarm(peers, m.infohash, pid, 8000, progress)
	if err != "" { fail(EXIT_EXTERNAL, "metadata_failed", "could not fetch metadata from any peer: " + err, []string{"retry -- another peer may serve it", "use a .torrent file instead"}) }
	raw = r }

func boolstr(v) (s) { s = "false"
	if v == 1 { s = "true" } }

// gather_peers announces to each tracker in turn and pools the results. It stops
// as soon as it has a workable swarm rather than announcing to every tracker,
// since each dead one costs a full timeout.
func gather_peers(announce, infohash, left, pid, port, timeout, progress) (peers) { peers = []Peer{}
	i := 0
	for i < len(announce) { u := announce[i]
		a := tracker_announce(u, infohash, pid, port, left, timeout)
		if a.ok == 1 { j := 0
			for j < len(a.peers) { if peer_new(peers, a.peers[j]) == 1 { peers = append(peers, a.peers[j]) }  j = j + 1 }
			if progress == 1 { eprint("essaim: " + u + " -> " + str(len(a.peers)) + " peers (" + str(a.seeders) + " seeders)") } }
		if a.ok == 0 { if progress == 1 { eprint("essaim: " + u + " -> " + a.err) } }
		if len(peers) >= 40 { return peers }
		i = i + 1 } }
