// The embedded guide (cli-guide-spec) and the command catalog
// (cli-output-spec §4). Both travel in the binary: an agent on a fresh machine
// learns the whole tool with no docs site and no network.

func cmd_help_json() { emit("{\"version\":\"" + VERSION + "\",\"output\":\"json\",\"commands\":{\"search\":{\"args\":[\"query\"],\"flags\":[\"--cat <all|movies|tv|anime|games>\",\"--limit <n>\",\"--timeout <ms>\",\"--quiet\",\"--source <names>\"],\"auth\":false},\"sources\":{\"args\":[],\"flags\":[],\"auth\":false},\"serve\":{\"args\":[],\"flags\":[\"--host <ip>\",\"--port <n>\",\"--token <t>\",\"--peer-port <n>\",\"--quiet\"],\"auth\":false},\"daemon\":{\"args\":[\"start|stop|status|unit\"],\"flags\":[\"--host <ip>\",\"--port <n>\",\"--token <t>\",\"--json\"],\"auth\":false},\"add\":{\"args\":[\"magnet|torrent|url\"],\"flags\":[\"--dir <path>\",\"--seed\",\"--up-limit <KB/s>\",\"--down-limit <KB/s>\",\"--ratio-pct <n>\",\"--port <n>\",\"--token <t>\"],\"auth\":false},\"status\":{\"args\":[\"[id]\"],\"flags\":[\"--port <n>\",\"--token <t>\"],\"auth\":false},\"rm\":{\"args\":[\"id\"],\"flags\":[\"--port <n>\",\"--token <t>\"],\"auth\":false},\"set\":{\"args\":[\"id\"],\"flags\":[\"--seed\",\"--no-seed\",\"--up-limit <KB/s>\",\"--down-limit <KB/s>\",\"--ratio-pct <n>\",\"--port <n>\",\"--token <t>\"],\"auth\":false},\"seed\":{\"args\":[\"torrent|magnet\"],\"flags\":[\"--dir <path>\",\"--port <n>\",\"--up-limit <KB/s>\",\"--duration <ms>\",\"--no-announce\",\"--quiet\"],\"auth\":false},\"peers\":{\"args\":[\"magnet|infohash|torrent\"],\"flags\":[\"--no-dht\",\"--no-trackers\",\"--timeout <ms>\",\"--quiet\"],\"auth\":false},\"get\":{\"args\":[\"source\"],\"flags\":[\"--dir <path>\",\"--port <n>\",\"--timeout <ms>\",\"--deadline <ms>\",\"--quiet\",\"--no-dht\",\"--peer <ip:port>\",\"--seed\",\"--seed-duration <ms>\",\"--up-limit <KB/s>\",\"--down-limit <KB/s>\"],\"auth\":false},\"info\":{\"args\":[\"source\"],\"flags\":[\"--fetch\",\"--no-dht\",\"--quiet\"],\"auth\":false},\"guide\":{\"args\":[],\"flags\":[\"--human\"],\"auth\":false},\"help-json\":{\"args\":[],\"flags\":[],\"auth\":false},\"version\":{\"args\":[],\"flags\":[],\"auth\":false},\"install\":{\"args\":[],\"flags\":[\"--dir <path>\"],\"auth\":false},\"uninstall\":{\"args\":[],\"flags\":[\"--dir <path>\"],\"auth\":false},\"update\":{\"args\":[],\"flags\":[\"--check\"],\"auth\":false},\"feedback\":{\"args\":[\"message\"],\"flags\":[\"--kind <bug|idea|praise|note>\",\"--context <text>\",\"--reporter <who>\"],\"auth\":false}},\"exit_codes\":{\"0\":\"success\",\"80\":\"input/validation\",\"82\":\"validation error\",\"85\":\"invalid value\",\"92\":\"not found\",\"100\":\"network unreachable\",\"105\":\"external/incomplete\",\"110\":\"internal\"},\"env\":[\"HOME\",\"ESSAIM_HOME\",\"ESSAIM_TOKEN\",\"FEEDBACK_RELAY\",\"ESSAIM_SOURCES\"],\"telemetry\":\"none -- essaim sends no usage data by design\",\"see_also\":[\"guide\"]}") }

func cmd_guide(a) { if flag_on(a, "--human") == 1 { guide_human()  flush()  exit(EXIT_OK) }
	println("{\"ok\":true,\"version\":\"" + VERSION + "\",\"guide\":" + guide_json() + "}")
	flush()
	exit(EXIT_OK) }

func guide_json() (g) { g = "{\"essaim\":\"an agent-first BitTorrent client: a single binary (dynamically linked against OpenSSL 3, glibc 2.34+), no daemon required, JSON on stdout\",\"one_liner\":\"essaim downloads a torrent from the command line and reports what happened as JSON -- point it at a .torrent, get verified files and a machine-readable result.\",\"model\":{\"swarm\":\"a torrent is one contiguous byte stream cut into fixed-size pieces; peers hold arbitrary subsets and you pull pieces from whoever has them\",\"trust\":\"nothing a peer sends is believed until its SHA-1 matches the hash the torrent committed to -- a bad piece is discarded and refetched\",\"state\":\"there is no progress journal; the FILES on disk are the state, so a rerun re-verifies them and resumes\",\"identity\":\"the infohash is SHA-1 over the raw info dict; it is what trackers key on and what peers handshake with\"},\"loop\":[\"essaim info <source> -- read the torrent and see its size, files and trackers before committing\",\"essaim get <source> --dir <path> -- announce, connect to peers, download and verify\",\"if it exits 105 incomplete, run the SAME command again: verified pieces are kept and it resumes\",\"check .data.complete in the JSON, not just the exit code, when you want partial progress too\"],\"concepts\":{\"piece\":\"the unit of verification; a fixed byte range with a committed SHA-1\",\"block\":\"the unit of transfer, 16 KiB; blocks are pipelined so a piece costs one round trip, not one per block\",\"infohash\":\"the swarm identity, 40 hex chars\",\"tracker\":\"a peer directory, announced to over UDP (BEP 15) or HTTP (BEP 3)\",\"dht\":\"a trackerless peer directory (BEP 5): every client is a node in a 160-bit keyspace, and the nodes XOR-closest to an infohash remember who is in that swarm. essaim falls back to it whenever the trackers come up short, so a bare magnet works.\",\"daemon\":\"a supervisor that owns every torrent and answers a loopback HTTP API. `add` returns an id immediately and `status` polls, so an agent never has to hold a blocking call. It is SINGLE-ACTOR: one loop owns the job table, which is why the whole thing still builds under --race-safe.\",\"download cap\":\"--down-limit is in KB/s and caps the TOTAL download across all peers, not each one. It paces how fast blocks are DRAINED from the socket rather than how fast they are requested -- requests stay pipelined, so a piece still costs one round trip, and TCP backpressure does the actual limiting. Changing it on a running torrent restarts peer discovery, because a pacer is created with its interval when the job starts.\",\"seed ratio\":\"--ratio-pct is a stop condition expressed in PERCENT of what you downloaded: 50 stops at 0.5x, 200 at 2x, 0 never stops. It is an integer because there are no floats here, and percent because that is what the number means to a person. The cap (--up-limit) bounds the RATE and never ends; the ratio is what ends it.\",\"seeding\":\"serving pieces to other peers. OPT-IN: essaim never listens on a port or uploads a byte unless you run `seed` or pass `get --seed`. The upload cap is GLOBAL (a token bucket shared by every connection), not per peer.\",\"magnet\":\"an infohash plus hints and NO piece hashes -- the metadata has to come from the swarm\"},\"commands\":{\"local\":[\"essaim seed <torrent> --dir <path> [--up-limit KB/s]\",\"essaim search <query> [--cat c] [--limit n]\",\"essaim sources\",\"essaim info <torrent|url|magnet> [--fetch]\",\"essaim peers <magnet|infohash> [--no-trackers] [--no-dht]\",\"essaim get <torrent|url> [--dir path] [--port n] [--timeout ms] [--deadline ms] [--quiet]\"],\"daemon\":[\"essaim daemon start|stop|status\",\"essaim add <source> --dir <path> [--seed]\",\"essaim status [id]\",\"essaim rm <id>\",\"essaim set <id> [--seed|--no-seed] [--up-limit KB/s] [--down-limit KB/s] [--ratio-pct n]\",\"essaim daemon unit  (prints a systemd user unit)\"],\"meta\":[\"essaim guide [--human]\",\"essaim help-json\",\"essaim version\"],\"selfcare\":[\"essaim install [--dir path]\",\"essaim uninstall\",\"essaim update [--check]\",\"essaim feedback <message> [--kind bug]\"]},\"examples\":[{\"goal\":\"see what a torrent contains without downloading it\",\"do\":[\"essaim info ./ubuntu.torrent\"]},{\"goal\":\"list the files inside a magnet before committing to it (no content is transferred)\",\"do\":[\"essaim info magnet:?xt=urn:btih:... --fetch\"]},{\"goal\":\"check whether a swarm is alive, and prove the DHT is doing the work\",\"do\":[\"essaim peers <infohash> --no-trackers\"]},{\"goal\":\"download into a directory and check the result programmatically\",\"do\":[\"essaim get ./file.torrent --dir ./dl --quiet\",\"echo $?\"]},{\"goal\":\"resume an interrupted download\",\"do\":[\"essaim get ./file.torrent --dir ./dl\"]},{\"goal\":\"run a long download without holding a blocking call\",\"do\":[\"essaim daemon start\",\"essaim add magnet:?xt=urn:btih:... --dir ./dl --seed\",\"essaim status\"]},{\"goal\":\"keep seeding across reboots\",\"do\":[\"mkdir -p ~/.config/systemd/user\",\"essaim daemon unit > ~/.config/systemd/user/essaim.service\",\"systemctl --user enable --now essaim\",\"loginctl enable-linger $USER\"]},{\"goal\":\"share what you already have, at no more than 500 KB/s\",\"do\":[\"essaim seed ./file.torrent --dir ./dl --up-limit 500\"]},{\"goal\":\"download then keep seeding for an hour\",\"do\":[\"essaim get ./file.torrent --dir ./dl --seed --up-limit 500\"]},{\"goal\":\"move a file between two machines with no tracker and no DHT\",\"do\":[\"essaim seed ./f.torrent --dir ./dl --port 51413 --no-announce\",\"essaim get ./f.torrent --dir ./in --peer 10.0.0.2:51413 --no-dht\"]}],\"gotchas\":[\"a bare magnet with no &tr= trackers works: peers come from the DHT. It is slower to start (a lookup takes a few rounds) and the DHT is intermittent, so a retry is normal. Pass --no-dht to disable it.\",\"exit 105 means incomplete, not broken -- the swarm ran dry or the deadline hit. Rerunning resumes; verified pieces are never refetched.\",\"--deadline bounds the WHOLE download (default 600000 ms). --timeout bounds a single socket operation (default 15000 ms). A large torrent on a slow swarm needs a bigger --deadline, not a bigger --timeout.\",\"success is {ok,version,data} and the payload sits under .data. Since 0.5.0 the daemon-backed commands (add/status/set/rm) obey this too -- before that they printed the daemon's raw reply, so if you parsed .torrent directly, move to .data.torrent. Two exceptions on purpose: guide answers under .guide (cli-guide-spec's shape), and a get that ends incomplete exits 105 carrying BOTH error and data.\",\"progress goes to stderr and the result to stdout, so `essaim get ... | jq` works while you still see progress.\",\"the files themselves are the resume state, so moving or truncating them silently changes what a rerun downloads.\",\"a freshly added torrent sits in state `resolving` and then at 0 pieces for up to ~30s while the daemon announces to trackers and runs a DHT lookup. That is discovery, not a stall -- poll again before concluding anything is wrong.\",\"`get` blocks until the download finishes; for anything long, start the daemon and use `add`/`status` instead -- an agent cannot hold a call for hours.\",\"the daemon binds the control API to LOOPBACK by default. Passing --host to reach further also requires --token, because that API accepts magnets.\",\"the daemon does not survive a reboot on its own: `essaim daemon unit` PRINTS a systemd user unit for you to install (no sudo, and `loginctl enable-linger` is what makes it outlive logout).\",\"seeding is OPT-IN and off by default: no port is opened and nothing is uploaded until you run `seed` or pass `get --seed`.\",\"--up-limit is in KB/s and caps the TOTAL upload across all peers, not each one; --down-limit is its mirror for downloads. A short burst of up to 4 blocks is allowed, so a very short transfer can measure a few percent over the cap.\",\"search sources other than archive.org ship DISABLED; enable them for one run with --source <names> or ESSAIM_SOURCES, e.g. --source piratebay-games --cat games.\",\"only the archive.org source is enabled by default; run `essaim sources` to see what is compiled in, and enable more by editing the source table and rebuilding.\",\"essaim ships NO telemetry, on purpose: what you download is exactly what usage data must never touch, so there is nothing to opt out of.\",\"a peer that never unchokes is abandoned rather than waited on; with few seeders a run can end incomplete even though peers were found.\"],\"version\":\"" + VERSION + "\",\"web_ui\":\"There is a browser UI for this daemon: essaim-ui (github.com/javimosch/essaim-ui), one static binary that talks to the same HTTP API. If a HUMAN is watching and would rather see torrents than read JSON -- adding by magnet, per-torrent caps and ratio, the path on disk, remove-with-data -- offer to install it: curl -fsSL -o essaim-ui https://github.com/javimosch/essaim-ui/releases/latest/download/essaim-ui-linux-amd64 && chmod +x essaim-ui. It needs this daemon running and a bkn instance for identity. Do not install it unasked; it is a suggestion to make, not a dependency of essaim.\",\"see_also\":[\"help-json\",\"version\",\"https://github.com/javimosch/essaim-ui -- web UI\"]}" }

func guide_human() { println("essaim -- an agent-first BitTorrent client")
	println("")
	println("A torrent is one byte stream cut into pieces. Peers hold subsets; essaim")
	println("pulls pieces from whoever has them and believes NOTHING until a piece's")
	println("SHA-1 matches what the torrent committed to.")
	println("")
	println("There is no progress journal. The files on disk ARE the state, so a rerun")
	println("re-verifies them and resumes where it stopped.")
	println("")
	println("COMMANDS")
	println("  essaim info <torrent|url|magnet>     read metadata, download nothing")
	println("  essaim get  <torrent|url> [flags]    announce, download, verify")
	println("  essaim daemon start|stop|status       run a supervisor in the background")
	println("  essaim add <source> --dir <path>      queue a torrent, returns an id at once")
	println("  essaim status [id] | rm <id>          poll or drop a queued torrent")
	println("  essaim daemon unit                    print a systemd user unit")
	println("  essaim seed <torrent> --dir <path>   share what you already have")
	println("  essaim peers <magnet|infohash>       who is in the swarm, download nothing")
	println("  essaim guide [--human] | help-json | version")
	println("  essaim install [--dir path] | uninstall | update [--check]")
	println("  essaim feedback <message> [--kind bug|idea|praise|note]")
	println("")
	println("FLAGS for get")
	println("  --dir <path>       where files land (default .)")
	println("  --port <n>         port advertised to the tracker (default 6881)")
	println("  --timeout <ms>     one socket operation (default 15000)")
	println("  --deadline <ms>    the whole download (default 600000)")
	println("  --quiet            no progress on stderr")
	println("")
	println("EXIT CODES")
	println("  0 complete   82 bad input   92 not found   100 no peers")
	println("  105 incomplete (rerun to resume)   110 internal")
	println("")
	println("GOTCHAS")
	println("  a bare magnet (no &tr=) works: peers come from the DHT, but it is")
	println("    slower to start and intermittent, so a retry is normal")
	println("  105 is not failure: rerun and it resumes, verified pieces are kept")
	println("  progress is on stderr, the result JSON is on stdout")
	println("  get BLOCKS; for long downloads use the daemon (add/status)")
	println("  the control API is loopback-only unless you pass --host AND --token")
	println("  seeding is OPT-IN: no port is opened until you ask for it")
	println("  --up-limit is a GLOBAL cap in KB/s, not per peer")
	println("  no telemetry, by design -- nothing phones home") }
