// Tracker announce, over HTTP (BEP 3) and UDP (BEP 15).
//
// A tracker is a peer directory: you say "I want infohash X" and it answers with
// addresses. Most public trackers are UDP-only -- it is one round trip instead of
// a TCP handshake plus HTTP -- which is precisely why essaim needed udp_socket /
// udp_sendto / udp_recvfrom in the language before it could exist.

type Peer struct { ip string  port int }

type Announce struct { peers []Peer  interval int  seeders int  leechers int  ok int  err string }

// peer_id_new builds the 20-byte client id in Azureus style: "-ES0001-" then 12
// random bytes. Returned as hex, since that is how every wire helper takes it.
func peer_id_new() (h) { h = to_hex(bytes("-ES0001-")) + to_hex(rand_bytes(12)) }

// tracker_announce dispatches on the URL scheme and normalizes both protocols
// to the same Announce value.
func tracker_announce(url, infohash, peerid, port, left, timeout_ms) (a) { a = Announce{peers: []Peer{}, ok: 0}
	if has_prefix(url, "udp://") { a = udp_announce(url, infohash, peerid, port, left, timeout_ms)  return a }
	if has_prefix(url, "http://") { a = http_announce(url, infohash, peerid, port, left, timeout_ms)  return a }
	if has_prefix(url, "https://") { a = http_announce(url, infohash, peerid, port, left, timeout_ms)  return a }
	a.err = "unsupported tracker scheme" }

// ---- HTTP ----

func http_announce(url, infohash, peerid, port, left, timeout_ms) (a) { a = Announce{peers: []Peer{}, ok: 0}
	sep := "?"
	if contains(url, "?") { sep = "&" }
	q := url + sep + "info_hash=" + pct_hex(infohash) + "&peer_id=" + pct_hex(peerid) + "&port=" + str(port) + "&uploaded=0&downloaded=0&left=" + str(left) + "&compact=1&numwant=200&event=started"
	status, body, err := http_get_b(q, timeout_ms)
	if err != "" { a.err = "tracker unreachable: " + err  return a }
	if status != 200 { a.err = "tracker http " + str(status)  return a }
	j := ben_json(body)
	if j == "" { a.err = "tracker reply is not bencode"  return a }
	fail := jraw(j, "failure reason")
	if fail != "" { a.err = "tracker refused: " + bytes_str(from_hex(fail))  return a }
	a.interval = jint(j, "interval")
	a.seeders = jint(j, "complete")
	a.leechers = jint(j, "incomplete")
	// compact form (BEP 23): `peers` is one 6-byte record per peer. The
	// non-compact form is a list of dicts; both appear in the wild.
	ph := jraw(j, "peers")
	if len(ph) > 0 { a.peers = peers_from_compact(from_hex(ph)) }
	if len(a.peers) == 0 { a.peers = peers_from_list(j) }
	a.ok = 1 }

func peers_from_compact(b) (out) { out = []Peer{}
	i := 0
	for i + 6 <= len(b) { p := Peer{ip: ipv4_str(b, i), port: rd16(b, i + 4)}
		if p.port > 0 { out = append(out, p) }
		i = i + 6 } }

func peers_from_list(j) (out) { out = []Peer{}
	i := 0
	for i < 512 { iph := jraw(j, "peers[" + str(i) + "].ip")
		if iph == "" { break }
		p := Peer{ip: bytes_str(from_hex(iph)), port: jint(j, "peers[" + str(i) + "].port")}
		if p.port > 0 { out = append(out, p) }
		i = i + 1 } }

// ---- UDP (BEP 15) ----
//
// Two round trips. First a connect exchange proves the client can receive at the
// address it claims (it defeats spoofed announces), yielding a connection id
// valid for a minute; then the announce itself. Both echo a transaction id that
// MUST be checked -- UDP has no connection, so a late reply to a previous
// request can otherwise be mistaken for the answer to this one.

func udp_announce(url, infohash, peerid, port, left, timeout_ms) (a) { a = Announce{peers: []Peer{}, ok: 0}
	host, tport := udp_url_split(url)
	if host == "" { a.err = "bad udp tracker url"  return a }
	fd := udp_socket(0)
	if fd < 0 { a.err = "cannot open udp socket"  return a }
	socket_timeout(fd, timeout_ms)
	txid := to_hex(rand_bytes(4))
	// connect: magic 0x41727101980, action 0, transaction id
	req := from_hex(be64_hex(4497486125440) + be32_hex(0) + txid)
	if udp_sendto(fd, host, tport, req) < 0 { close(fd)  a.err = "udp send failed"  return a }
	resp, _, rport := udp_recvfrom(fd)
	if rport == 0 { close(fd)  a.err = "tracker timeout (connect)"  return a }
	if len(resp) < 16 { close(fd)  a.err = "short connect reply"  return a }
	if rd32(resp, 0) != 0 { close(fd)  a.err = "tracker error on connect"  return a }
	if to_hex(bytes_sub(resp, 4, 8)) != txid { close(fd)  a.err = "connect transaction id mismatch"  return a }
	connid := to_hex(bytes_sub(resp, 8, 16))
	// announce: event 2 = started, numwant 200, our listen port
	txid2 := to_hex(rand_bytes(4))
	areq := from_hex(connid + be32_hex(1) + txid2 + infohash + peerid + be64_hex(0) + be64_hex(left) + be64_hex(0) + be32_hex(2) + be32_hex(0) + to_hex(rand_bytes(4)) + be32_hex(200) + be16_hex(port))
	if udp_sendto(fd, host, tport, areq) < 0 { close(fd)  a.err = "udp announce send failed"  return a }
	ar, _, aport := udp_recvfrom(fd)
	close(fd)
	if aport == 0 { a.err = "tracker timeout (announce)"  return a }
	if len(ar) < 20 { a.err = "short announce reply"  return a }
	if rd32(ar, 0) == 3 { a.err = "tracker error: " + bytes_str(bytes_sub(ar, 8, len(ar)))  return a }
	if rd32(ar, 0) != 1 { a.err = "unexpected action in announce reply"  return a }
	if to_hex(bytes_sub(ar, 4, 8)) != txid2 { a.err = "announce transaction id mismatch"  return a }
	a.interval = rd32(ar, 8)
	a.leechers = rd32(ar, 12)
	a.seeders = rd32(ar, 16)
	a.peers = peers_from_compact(bytes_sub(ar, 20, len(ar)))
	a.ok = 1 }

func udp_url_split(url) (host, port) { host = ""  port = 0
	rest := substr(url, 6, len(url))
	slash := index(rest, "/")
	if slash >= 0 { rest = substr(rest, 0, slash) }
	colon := index(rest, ":")
	if colon < 0 { return host, port }
	host = substr(rest, 0, colon)
	port = parse_int(substr(rest, colon + 1, len(rest)))
	if port <= 0 { host = "" } }
