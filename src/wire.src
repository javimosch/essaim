// Big-endian packing/unpacking. Every byte on the BitTorrent wire -- the UDP
// tracker protocol, the peer handshake, the message framing -- is network order.
//
// Values are BUILT as hex strings and turned into bytes with from_hex(), rather
// than poked into a buffer: bytes values are immutable here, hex concatenation
// is obvious to read against the spec's field tables, and it sidesteps the
// signed-overflow question entirely (MFL ints are 64-bit signed, so shifting a
// 32-bit field's high bit around is a place bugs hide).

func hex_of_byte(b) (s) { d := "0123456789abcdef"
	v := b
	if v < 0 { v = 0 }
	if v > 255 { v = 255 }
	s = charat(d, v / 16) + charat(d, v - (v / 16) * 16) }

func be16_hex(n) (s) { v := n
	if v < 0 { v = 0 }
	s = hex_of_byte(v / 256) + hex_of_byte(v - (v / 256) * 256) }

func be32_hex(n) (s) { v := n
	if v < 0 { v = 0 }
	s = ""
	i := 3
	for i >= 0 { s = s + hex_of_byte(byte_of(v, i))  i = i - 1 } }

func be64_hex(n) (s) { v := n
	if v < 0 { v = 0 }
	s = ""
	i := 7
	for i >= 0 { s = s + hex_of_byte(byte_of(v, i))  i = i - 1 } }

// byte_of extracts byte i (0 = least significant) by division, not shifting.
func byte_of(v, i) (b) { d := 1
	k := 0
	for k < i { d = d * 256  k = k + 1 }
	b = (v / d) - ((v / d) / 256) * 256 }

func rd8(b, off) (v) { v = 0
	if off < 0 { return v }
	if off >= len(b) { return v }
	v = byte_at(b, off) }

func rd16(b, off) (v) { v = rd8(b, off) * 256 + rd8(b, off + 1) }

func rd32(b, off) (v) { v = rd16(b, off) * 65536 + rd16(b, off + 2) }

func rd64(b, off) (v) { v = rd32(b, off) * 4294967296 + rd32(b, off + 4) }

// pct_hex percent-encodes the bytes a hex string denotes. A tracker's
// info_hash/peer_id query params are RAW 20-byte values, so they cannot go
// through url_encode (a string builtin that stops at a NUL) -- every byte is
// escaped unconditionally, which is always valid and never ambiguous.
func pct_hex(h) (out) { out = ""
	i := 0
	for i + 1 < len(h) { out = out + "%" + substr(h, i, i + 2)  i = i + 2 } }

// ipv4_str renders the 4 bytes at off as dotted quad -- the compact peer format
// (BEP 23) is 6 bytes per peer: 4 of address, 2 of port.
func ipv4_str(b, off) (s) { s = str(rd8(b, off)) + "." + str(rd8(b, off + 1)) + "." + str(rd8(b, off + 2)) + "." + str(rd8(b, off + 3)) }

// json_unescape turns the escape sequences of a JSON string back into the text
// they stand for.
//
// machin's json_get hands back the RAW characters between the quotes, escapes
// and all, so a name arrived as a literal backslash-u-2-0-0-b rather than the
// zero-width space it means. That was visible as junk in a title, and fatal in
// a magnet: Go's encoding/json escapes & as & by default, so a magnet
// posted by essaim-ui reached the daemon with a literal & where every
// separator belonged, and the record landed with "no btih infohash".
//
// Escaping is done by jesc on the way out; this is the missing other half.
func hexnib(c) (v) { v = 0 - 1
	d := "0123456789abcdef"
	lc := to_lower(c)
	i := 0
	for i < 16 { if charat(d, i) == lc { v = i  return v }
		i = i + 1 } }

// utf8_of encodes a code point. There are no bitwise operators here, so the
// shifts and masks are division and remainder, like byte_of above.
func utf8_of(cp) (s) { s = ""
	if cp < 0 { return s }
	if cp < 128 { s = bytes_str(from_hex(hex_of_byte(cp)))  return s }
	if cp < 2048 { s = bytes_str(from_hex(hex_of_byte(192 + cp / 64) + hex_of_byte(128 + cp - (cp / 64) * 64)))  return s }
	if cp < 65536 { s = bytes_str(from_hex(hex_of_byte(224 + cp / 4096) + hex_of_byte(128 + (cp / 64) - (cp / 4096) * 64) + hex_of_byte(128 + cp - (cp / 64) * 64)))  return s }
	s = bytes_str(from_hex(hex_of_byte(240 + cp / 262144) + hex_of_byte(128 + (cp / 4096) - (cp / 262144) * 64) + hex_of_byte(128 + (cp / 64) - (cp / 4096) * 64) + hex_of_byte(128 + cp - (cp / 64) * 64))) }

// hex4 reads the four hex digits of a \uXXXX at i, or -1 if they are not there.
func hex4(s, i) (cp) { cp = 0
	if i + 4 > len(s) { cp = 0 - 1  return cp }
	k := 0
	for k < 4 { v := hexnib(charat(s, i + k))
		if v < 0 { cp = 0 - 1  return cp }
		cp = cp * 16 + v
		k = k + 1 } }

func json_unescape(s) (out) { out = ""
	i := 0
	for i < len(s) { c := charat(s, i)
		if c != "\\" { out = out + c
			i = i + 1 }
		if c == "\\" { if i + 1 >= len(s) { out = out + c
				i = i + 1 }
			if i + 1 < len(s) { e := charat(s, i + 1)
				if e == "n" { out = out + "\n"  i = i + 2 }
				if e == "t" { out = out + "\t"  i = i + 2 }
				if e == "r" { out = out + "\r"  i = i + 2 }
				if e == "b" { i = i + 2 }
				if e == "f" { i = i + 2 }
				if e == "\"" { out = out + "\""  i = i + 2 }
				if e == "\\" { out = out + "\\"  i = i + 2 }
				if e == "/" { out = out + "/"  i = i + 2 }
				if e == "u" { cp := hex4(s, i + 2)
					if cp < 0 { out = out + c  i = i + 1 }
					if cp >= 0 { i = i + 6
						// A code point above the BMP arrives as a SURROGATE
						// PAIR: two \u escapes that mean one character, and
						// decoding them separately yields two invalid ones.
						if cp >= 55296 { if cp < 56320 { if i + 1 < len(s) { if charat(s, i) == "\\" { if charat(s, i + 1) == "u" { lo := hex4(s, i + 2)
													if lo >= 56320 { if lo < 57344 { cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
															i = i + 6 } } } } } } }
						out = out + utf8_of(cp) } }
				// An unknown escape is not a licence to drop the backslash.
				if e != "n" { if e != "t" { if e != "r" { if e != "b" { if e != "f" { if e != "\"" { if e != "\\" { if e != "/" { if e != "u" { out = out + c + e
					i = i + 2 } } } } } } } } } } } } }
