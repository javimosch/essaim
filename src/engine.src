// The download engine: many peer goroutines, one owner of the truth.
//
// Concurrency shape: main owns the have-set and the work queue; each peer runs
// on its own goroutine with its own socket, and the two talk ONLY over channels.
// That is not stylistic -- a goroutine's value-arena is reclaimed when it
// returns, so anything it computed and left in shared memory would dangle.
// Channel sends copy, so results survive their sender.
//
// Work assignment is pull-based: a worker takes a piece index, and if its peer
// does not have that piece it hands the index straight back. With a healthy
// swarm this converges quickly and needs no global rarity bookkeeping.

type Res struct { kind string  idx int  ok int  peer string  err string }

type Stats struct { done int  total int  bytes int  peers_ok int  peers_dead int  elapsed int  complete int }

// peer_worker owns one peer connection for its whole life.
func peer_worker(host, pport, t, dir, infohash, peerid, work, res, timeout, grant, limited) { who := host + ":" + str(pport)
	fd := dial(host, pport)
	if fd < 0 { res <- json(Res{kind: "gone", idx: 0 - 1, peer: who, err: "connect failed"})  return }
	socket_timeout(fd, timeout)
	buf, ok, _ := peer_handshake(fd, infohash, peerid)
	if ok == 0 { close(fd)  res <- json(Res{kind: "gone", idx: 0 - 1, peer: who, err: "handshake failed"})  return }
	write_bytes(fd, msg_simple(2))
	// Read until unchoked, learning the peer's bitfield on the way. A peer that
	// never unchokes us is not useful, so the wait is bounded.
	bf := bytes("")
	unchoked := 0
	spins := 0
	for unchoked == 0 { spins = spins + 1
		if spins > 512 { close(fd)  res <- json(Res{kind: "gone", idx: 0 - 1, peer: who, err: "never unchoked"})  return }
		f := peer_msg(fd, buf)
		buf = f.buf
		if f.ok == 0 { close(fd)  res <- json(Res{kind: "gone", idx: 0 - 1, peer: who, err: "closed while choked"})  return }
		if f.id == 5 { bf = f.payload }
		if f.id == 4 { bf = bitfield_set(bf, rd32(f.payload, 0), t.npieces) }
		if f.id == 1 { unchoked = 1 } }
	res <- json(Res{kind: "ready", idx: 0 - 1, peer: who})
	// EVERY PIECE IS FETCHED INSIDE ITS OWN ARENA.
	//
	// This goroutine runs for the whole download, and a goroutine's arena is
	// only reclaimed when it RETURNS -- so without a scoped arena, every piece
	// it ever assembled is still held when the last one arrives. Measured at
	// ~13 MB per piece on a 4 MB-piece torrent (the piece, the buffer it was
	// concatenated into, and the copy handed to the writer): 15 GB of RSS in
	// 15 minutes, on both the daemon and the CLI.
	//
	// Only `buf` outlives the block -- it is the rolling read buffer, carrying
	// whatever arrived after the piece -- so it is the one value that escapes.
	// Channel sends are NOT escapes: the runtime deep-copies what crosses.
	//
	// Nothing returns from inside the block: a return would skip the block's
	// cleanup and leave the arena pointer dangling (machin reports that as
	// ARENA002), so "this peer is finished" is recorded and acted on after.
	for 1 == 1 { idx := <-work
		if idx < 0 { close(fd)  return }
		if bitfield_has(bf, idx) == 0 { res <- json(Res{kind: "nohave", idx: idx, peer: who})  continue }
		dead := 0
		arena { data, nbuf, got := peer_fetch_piece(fd, buf, idx, piece_size(t, idx), 1, grant, limited)
			buf = escape(nbuf)
			if got == 0 { res <- json(Res{kind: "gone", idx: idx, peer: who, err: "dropped mid-piece"})
				dead = 1 }
			if got == 1 { verified := piece_ok(t, idx, data)
				if verified == 0 { res <- json(Res{kind: "bad", idx: idx, peer: who, err: "hash mismatch"}) }
				if verified == 1 { wrote := store_write_piece(t, dir, idx, data)
					if wrote < 0 { res <- json(Res{kind: "bad", idx: idx, peer: who, err: "write failed"}) }
					if wrote >= 0 { res <- json(Res{kind: "piece", idx: idx, ok: 1, peer: who}) } } } }
		if dead == 1 { close(fd)  return } } }

// bitfield_set records a `have` announcement arriving after the bitfield.
func bitfield_set(bf, idx, npieces) (out) { out = bf
	need := (npieces + 7) / 8
	if len(out) < need { pad := ""
		i := len(out)
		for i < need { pad = pad + "00"  i = i + 1 }
		out = bytes_concat(out, from_hex(pad)) }
	byteoff := idx / 8
	if byteoff >= len(out) { return out }
	bit := idx - byteoff * 8
	mask := 128
	k := 0
	for k < bit { mask = mask / 2  k = k + 1 }
	v := rd8(out, byteoff)
	if (v / mask) - ((v / mask) / 2) * 2 == 0 { v = v + mask }
	out = bytes_concat(bytes_concat(bytes_sub(out, 0, byteoff), from_hex(hex_of_byte(v))), bytes_sub(out, byteoff + 1, len(out))) }

// ---- the job: a download the supervisor can PUMP instead of block on ----
//
// engine_download blocks, which is right for `essaim get` and useless for a
// daemon that has to serve HTTP and run several torrents at once. So the loop is
// split: job_start spawns the workers and returns, job_pump drains whatever has
// arrived and returns immediately. The blocking form is then just a pump loop,
// so there is one implementation of the logic, not two.

// dgrant is the download pacer's channel, shared by every peer goroutine so the
// cap is global rather than per connection. It exists even when uncapped,
// because a struct field cannot be conditionally absent -- dlimited decides
// whether anybody waits on it.
type Job struct { id string  dir string  t Torrent  work chan int  res chan string  have []int  live int  nworkers int  nohaves int  s Stats  started int  active int  dgrant chan int  dlimited int  down_limit int  cursor int  outstanding int  window int }

// dpacer issues one grant per block at the configured rate, and deliberately
// has NO acknowledgement channel.
//
// The upload pacer counts outstanding grants so an idle period cannot be banked
// as a burst. Copying that here deadlocked: a downloader takes a grant and
// immediately acks, so with every peer blocked sending an ack and the pacer
// blocked sending the next grant, nobody was left to receive one. An unbuffered
// channel already gives the property the ack was there to provide -- the pacer
// cannot run ahead, because `grant <- 1` blocks until a peer actually takes it,
// so at most one grant is ever outstanding.
func dpacer(grant, interval_ms) { for 1 == 1 { grant <- 1
		sleep(interval_ms) } }

func job_start(id, t, dir, peers, peerid, timeout, down_limit_kbs) (j) { j = Job{id: id, dir: dir, t: t, work: make(chan int), res: make(chan string), have: []int{}, live: 0, nworkers: 0, nohaves: 0, s: Stats{total: t.npieces}, started: now_ms(), active: 1, dgrant: make(chan int), dlimited: 0, down_limit: down_limit_kbs}
	j.have = store_scan(t, dir)
	i := 0
	for i < t.npieces { if j.have[i] == 1 { j.s.done = j.s.done + 1  j.s.bytes = j.s.bytes + piece_size(t, i) }  i = i + 1 }
	if j.s.done == t.npieces { j.s.complete = 1  j.active = 0  return j }
	// One grant per 16 KiB block at the requested rate.
	if down_limit_kbs > 0 { j.dlimited = 1
		interval := (BLOCK * 1000) / (down_limit_kbs * 1024)
		if interval < 1 { interval = 1 }
		go dpacer(j.dgrant, interval) }
	i = 0
	// Queue a WINDOW, not every missing piece.
	//
	// This used to push all 2923 indices of a big torrent into the work
	// channel at once. machin's channels are unbounded, so that queue simply
	// sat there -- and the daemon's cost per tick was measured to track its
	// LENGTH: ~10 MB per tick with it full, 179 kB once drained, on the same
	// torrent with everything else unchanged. 15 GB of RSS in 15 minutes.
	//
	// A window deep enough to keep every worker fed is all the queue is for.
	j.window = len(peers) * 4 + 8
	j.cursor = 0
	j.outstanding = 0
	i = 0
	for i < len(peers) { go peer_worker(peers[i].ip, peers[i].port, t, dir, t.infohash, peerid, j.work, j.res, timeout, j.dgrant, j.dlimited)
		j.live = j.live + 1
		j.nworkers = j.nworkers + 1
		i = i + 1 }
	if j.live == 0 { j.active = 0 }
	if j.active == 1 { js := []Job{j}
		fill_work_at(js, 0)
		j = js[0] } }

// fill_work_at tops the queue back up to the window, walking the pieces still
// missing. When a pass ends with pieces outstanding nowhere, it starts again --
// a piece no peer had a minute ago may be served by the next peer to connect.
func fill_work_at(jobs, i) { guard := 0
	for jobs[i].outstanding < jobs[i].window { guard = guard + 1
		if guard > jobs[i].t.npieces + 1 { return }
		if jobs[i].cursor >= jobs[i].t.npieces { if jobs[i].outstanding > 0 { return }
			jobs[i].cursor = 0 }
		c := jobs[i].cursor
		jobs[i].cursor = c + 1
		if jobs[i].have[c] == 0 { jobs[i].work <- c
			jobs[i].outstanding = jobs[i].outstanding + 1 } } }

// job_pump_at drains a job IN PLACE, by index into the caller's slice.
//
// It does not take or return a Job, and that is the whole point. A Job holds
// the work channel, and machin channels are unbounded: job_start queues every
// missing piece index into it, so early on that queue holds thousands of
// entries. Copying a Job copies that queue -- and the daemon ran
// `jobs[i] = job_pump(jobs[i], 0)` five times a second, paying two such copies
// per tick into the main loop's arena, WHICH IS NEVER RECLAIMED because that
// goroutine never returns.
//
// Measured on a 2923-piece torrent: ~10 MB per tick with the queue full, 179 kB
// per tick once it had drained -- the cost tracked the queue, not the pieces.
// In the field that was 15 GB of RSS in 15 minutes. The CLI never showed it,
// because engine_download pumps a LOCAL variable and a local is not copied into
// an arena; only the slice element was.
//
// Slices are reference-like here (a callee mutates the caller's elements), so
// the fix is to mutate through the slice and never form a Job value at all.
// `progress` echoes each verified piece to stderr for the foreground path.
func job_pump_at(jobs, i, progress) { if jobs[i].active == 0 { return }
	drained := 1
	for drained == 1 { drained = 0
		// Yield when every live peer has refused the queue head: a "nohave" is
		// requeued at once, so the peer that just refused it takes it again.
		// Leaving the messages queued for the next tick is what makes the
		// workers block on an empty queue and the ping-pong cool.
		if job_starved(jobs[i]) == 1 { jobs[i].nohaves = 0
			return }
		select { case m := <-jobs[i].res: drained = 1
			r := parse(m, Res{})
			if r.kind == "ready" { jobs[i].s.peers_ok = jobs[i].s.peers_ok + 1 }
			if r.kind == "gone" { jobs[i].live = jobs[i].live - 1
				jobs[i].s.peers_dead = jobs[i].s.peers_dead + 1
				// a peer that died holding a piece hands it back, so the work is
				// not lost with the connection
				if r.idx >= 0 { jobs[i].work <- r.idx } }
			if r.kind == "nohave" { jobs[i].nohaves = jobs[i].nohaves + 1
				jobs[i].work <- r.idx }
			if r.kind == "bad" { jobs[i].work <- r.idx }
			if r.kind == "piece" { jobs[i].outstanding = jobs[i].outstanding - 1
				if jobs[i].have[r.idx] == 0 { jobs[i].have[r.idx] = 1
					jobs[i].s.done = jobs[i].s.done + 1
					jobs[i].s.bytes = jobs[i].s.bytes + piece_size(jobs[i].t, r.idx)
					if progress == 1 { eprint("piece " + str(jobs[i].s.done) + "/" + str(jobs[i].t.npieces) + " from " + r.peer) } } }
		default: } }
	if jobs[i].active == 1 { fill_work_at(jobs, i) }
	if jobs[i].s.done >= jobs[i].t.npieces { jobs[i].s.complete = 1
		job_stop_at(jobs, i) }
	if jobs[i].live <= 0 { job_stop_at(jobs, i) }
	jobs[i].s.elapsed = now_ms() - jobs[i].started }

// job_stop_at retires the workers in place, for the same reason.
func job_stop_at(jobs, i) { if jobs[i].active == 0 { return }
	k := 0
	for k < jobs[i].nworkers { jobs[i].work <- 0 - 1
		k = k + 1 }
	jobs[i].active = 0 }

// job_starved reports that every live peer refused the queue head, which means
// nobody has it yet and the caller should yield rather than spin.
func job_starved(j) (yes) { yes = 0
	if j.live > 0 { if j.nohaves > j.live * 4 { yes = 1 } } }

// engine_download is the blocking form: start, then pump until done or the
// deadline. Same logic, one implementation.
func engine_download(t, dir, peers, peerid, timeout, deadline_ms, down_limit_kbs, progress) (s) { jobs := []Job{job_start("cli", t, dir, peers, peerid, timeout, down_limit_kbs)}
	// A one-element slice, so the blocking path and the daemon share ONE pump.
	// It also costs nothing: pumping in place is what stops the Job -- and the
	// queue inside it -- being copied on every iteration.
	for jobs[0].active == 1 { if now_ms() - jobs[0].started > deadline_ms { job_stop_at(jobs, 0)
			break }
		job_pump_at(jobs, 0, progress)
		if job_starved(jobs[0]) == 1 { jobs[0].nohaves = 0  sleep(200) }
		if jobs[0].active == 1 { sleep(20) } }
	s = jobs[0].s
	s.elapsed = now_ms() - jobs[0].started
	if s.done >= t.npieces { s.complete = 1 } }
